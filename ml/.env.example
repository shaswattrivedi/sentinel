# SENTINEL ML Service Environment Variables
# Copy this file to .env and adjust as needed

# Server Configuration
ML_HOST=0.0.0.0
ML_PORT=8000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:4000

# Logging
LOG_LEVEL=INFO

# Hardware live runner configuration
ML_SERVICE_URL=http://localhost:8000/predict
ZONE_STREAM_URLS=zone-1=http://10.0.0.10:81/stream,zone-2=http://10.0.0.11:81/stream
ZONE_SENSOR_ENDPOINTS=zone-1=10.0.0.20,zone-2=10.0.0.21
